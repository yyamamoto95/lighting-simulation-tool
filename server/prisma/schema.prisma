generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 照明設計プロジェクト（将来的な複数プロジェクト・共有機能の基盤）
model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lights    Light[]
}

// 照明オブジェクト1つ分のデータ
model Light {
  id              String  @id @default(cuid())
  projectId       String
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String  // "spotlight" | "cone" | "cylinder-a" | "cylinder-b"
  color           Int     // 16進数カラー値
  intensity       Float
  positionX       Float
  positionY       Float
  positionZ       Float
  targetPositionX Float
  targetPositionY Float
  targetPositionZ Float
  order           Int     @default(0)
}
